# Copy this file to .env and fill in real values.
# NEVER commit the real .env — it holds secrets.

# Secret used for session signing / CSRF
MECHVAULT_SECRET=change-me-to-a-long-random-string

# opencode-zen API key for AI note generation (optional; app works without it)
OPENCODE_ZEN_API_KEY=your-opencode-zen-key-here
MECHVAULT_AI_MODEL=nemotron-3-ultra-free

# Owner/admin bootstrap account created by seed.py
MECHVAULT_OWNER_EMAIL=admin@mechvault.local
MECHVAULT_OWNER_PASSWORD=admin1234

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { isSingleUser } from "../lib/auth-single";

// Single-user mode must not import lib/auth at all: that import reaches the
// database, which is the whole thing this mode exists to avoid. A static
// import would make the no-DB path depend on the DB.
let loggedInName: string | null = null;

if (isSingleUser()) {
  const { singleUserSession } = await import("../lib/auth-single");
  const s = await singleUserSession(Astro.request);
  loggedInName = s?.user.username ?? null;
} else {
  const { getSessionSafe } = await import("../lib/auth");
  const session = await getSessionSafe(Astro.request.headers).catch(() => null);
  loggedInName = session ? ((session.user as { username?: string }).username ?? null) : null;
}

if (loggedInName) {
  const next = Astro.url.searchParams.get("next") || "/";
  // Only same-origin relative redirects: an absolute or protocol-relative `next`
  // would turn the login page into an open redirect.
  return Astro.redirect(next.startsWith("/") && !next.startsWith("//") ? next : "/");
}
---
<BaseLayout title="Sign in · MechVault" skipSession>
  <section class="auth-wrap">
    <div class="auth-card" id="auth-card" data-mode={isSingleUser() ? "single" : "db"}>
      <div class="auth-logo">M</div>
      <h1>Sign in</h1>
      <p class="auth-sub">Access the MechVault study hub with your username.</p>
      <form id="login-form" class="auth-form">
        <label>
          <span>Username</span>
          <input type="text" name="username" id="login-username" autocomplete="username" required aria-describedby="login-error">
        </label>
        <label>
          <span>Password</span>
          <input type="password" name="password" id="login-password" autocomplete="current-password" required aria-describedby="login-error">
        </label>
        <div class="auth-error" id="login-error" role="alert" hidden></div>
        <button type="submit" class="btn btn-accent auth-submit">Sign in →</button>
      </form>
      {isSingleUser() ? (
        <p class="auth-alt">Single-user mode. Tracker state is stored in this browser only.</p>
      ) : (
        <p class="auth-alt">Don't have an account? <a href="/register">Create one</a></p>
      )}
    </div>
  </section>

  <!--
    The auth mode is passed as a data attribute rather than `define:vars`,
    because `define:vars` forces is:inline: that would disable TypeScript AND
    module imports, so `authClient` could no longer be imported at all. With a
    normal processed <script>, both work.
  -->
  <script>
    import { authClient } from "../lib/auth-client";

    const single =
      document.getElementById("auth-card")?.dataset.mode === "single";

    const next = new URLSearchParams(window.location.search).get("next") || "/";
    const form = document.getElementById("login-form") as HTMLFormElement;
    const err = form.querySelector(".auth-error") as HTMLDivElement;
    const btn = form.querySelector(".auth-submit") as HTMLButtonElement;
    const usernameInput = form.querySelector('#login-username') as HTMLInputElement;
    const passwordInput = form.querySelector('#login-password') as HTMLInputElement;
    let errorMessage: string | null = null;

    [usernameInput, passwordInput].forEach((inp) => {
      inp?.addEventListener("input", () => {
        inp.removeAttribute("aria-invalid");
      });
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      err.hidden = true;
      err.textContent = "";
      usernameInput?.removeAttribute("aria-invalid");
      passwordInput?.removeAttribute("aria-invalid");
      errorMessage = null;
      btn.disabled = true;
      const fd = new FormData(form);
      const username = String(fd.get("username") || "").trim();
      const password = String(fd.get("password") || "");

      if (single) {
        const res = await fetch("/api/single-login", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ username, password, next }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) errorMessage = data.error || "Sign in failed.";
      } else {
        const out = await authClient.signIn.username({ username, password });
        if (out.error) {
          errorMessage = out.error.message || "Incorrect username or password.";
        }
      }

      btn.disabled = false;
      if (errorMessage) {
        err.hidden = false;
        err.textContent = errorMessage;
        usernameInput?.setAttribute("aria-invalid", "true");
        passwordInput?.setAttribute("aria-invalid", "true");
        return;
      }
      const dest = next.startsWith("/") && !next.startsWith("//") ? next : "/";
      window.location.href = dest;
    });
  </script>
</BaseLayout>

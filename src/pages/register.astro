---
import BaseLayout from "../layouts/BaseLayout.astro";
import { isSingleUser } from "../lib/auth-single";
import type { AuthUser } from "../lib/auth";

if (isSingleUser()) {
  return Astro.redirect("/login");
}

const { getSessionSafe } = await import("../lib/auth");

let loggedIn: AuthUser | null = null;
try {
  const session = await getSessionSafe(Astro.request.headers);
  if (session) loggedIn = session.user as AuthUser;
} catch {
  // Neon still cold-starting — render the form; the client will handle retries.
}
if (loggedIn) {
  return Astro.redirect("/");
}
---
<BaseLayout title="Request access · MechVault" skipSession>
  <section class="auth-wrap">
    <div class="auth-card">
      <div class="auth-logo">M</div>
      <h1>Create account</h1>
      <p class="auth-sub">This vault is private. Make an account, sign in, and your tracker state follows your account — not your browser.</p>
      <form id="register-form" class="auth-form">
        <label>
          <span>Username</span>
          <input type="text" name="username" id="register-username" autocomplete="username" minlength="3" maxlength="30" required aria-describedby="register-error">
        </label>
        <label>
          <span>Display name (optional)</span>
          <input type="text" name="name" autocomplete="name" aria-describedby="register-error">
        </label>
        <label>
          <span>Password</span>
          <input type="password" name="password" id="register-password" autocomplete="new-password" minlength="8" required aria-describedby="register-error">
        </label>
        <label>
          <span>Confirm password</span>
          <input type="password" name="confirm" id="register-confirm" autocomplete="new-password" minlength="8" required aria-describedby="register-error">
        </label>
        <div class="auth-error" id="register-error" role="alert" hidden></div>
        <button type="submit" class="btn btn-accent auth-submit">Create account →</button>
      </form>
      <p class="auth-alt">Already have an account? <a href="/login">Sign in</a></p>
    </div>
  </section>

  <script>
    import { authClient } from "../lib/auth-client";
    const form = document.getElementById("register-form") as HTMLFormElement;
    const err = form.querySelector(".auth-error") as HTMLDivElement;
    const btn = form.querySelector(".auth-submit") as HTMLButtonElement;
    const usernameInput = form.querySelector('#register-username') as HTMLInputElement;
    const confirmInput = form.querySelector('#register-confirm') as HTMLInputElement;

    form.querySelectorAll("input").forEach((inp) => {
      inp.addEventListener("input", () => {
        inp.removeAttribute("aria-invalid");
      });
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      err.hidden = true;
      err.textContent = "";
      usernameInput?.removeAttribute("aria-invalid");
      confirmInput?.removeAttribute("aria-invalid");
      const fd = new FormData(form);
      const username = String(fd.get("username") || "").trim();
      const name = String(fd.get("name") || "").trim() || username;
      const password = String(fd.get("password") || "");
      const confirm = String(fd.get("confirm") || "");
      if (password !== confirm) {
        err.hidden = false;
        err.textContent = "Passwords do not match.";
        confirmInput?.setAttribute("aria-invalid", "true");
        return;
      }
      btn.disabled = true;
      const { error } = await authClient.signUp.email({
        username,
        name,
        email: `${username}@mechvault.local`,
        password,
      });
      btn.disabled = false;
      if (error) {
        err.hidden = false;
        err.textContent = error.message || "Could not create account. Try a different username.";
        usernameInput?.setAttribute("aria-invalid", "true");
        return;
      }
      window.location.href = "/";
    });
  </script>
</BaseLayout>

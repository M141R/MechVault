---
/**
 * Dashboard — the exam-countdown and real-coverage view.
 *
 * Replaces the old hardcoded `progress: 100` on every subject card. Coverage
 * here is computed from the user's actual topic/problem state, so a blank
 * tracker honestly reads 0%.
 *
 * If the database is unreachable the page says so instead of rendering 0%,
 * because "0% covered" and "could not load" are very different statements.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { trackerIsLocal } from "../lib/auth-single";
import { TRACKER, TRACKER_ORDER, studyAction } from "../lib/tracker/config";
import {
  TOPIC_COVERED,
  TOPIC_MASTERED,
  PROBLEM_COVERED,
  PROBLEM_MASTERED,
  isTopicState,
  isProblemState,
  tally,
  pct,
  countDaysUntil,
  type TopicStateName,
  type ProblemStateName,
} from "../lib/tracker/engine";
import { subjectMark } from "../lib/tracker/subject-marks";

/** End-sem window for BIT Mesra, November 2026. Confirmed by the user. */
const EXAM_START = "2026-11-17";
const EXAM_END = "2026-11-25";
/** Subject-wise order is NOT yet published — do not pretend otherwise. */
const EXAM_ORDER_KNOWN = false;

const local = trackerIsLocal();
type Who = { id: string; username?: string; name?: string };
let user: Who | null = null;

if (local) {
  const { singleUserSession } = await import("../lib/auth-single");
  const s = await singleUserSession(Astro.request);
  // singleUserSession wraps the user in `{ user }`; unwrap it.
  user = (s?.user ?? null) as Who | null;
} else {
  const { getSessionSafe } = await import("../lib/auth");
  const s = await getSessionSafe(Astro.request.headers).catch(() => null);
  user = (s?.user ?? null) as Who | null;
}

const days = countDaysUntil(EXAM_START);
const windowDays = countDaysUntil(EXAM_END);

const topicState = new Map<string, TopicStateName>();
const problemState = new Map<string, ProblemStateName>();
let loadError: string | null = null;

// In single-user mode the server has no state; the client hydrates the DOM from
// localStorage after load, so the figures below legitimately start at zero.
if (!local && user) {
  try {
    const { readStates } = await import("../lib/tracker/store");
    const { topics, problems } = await readStates(user.id);
    for (const t of topics) topicState.set(t.key, (isTopicState(t.state) ? t.state : "unseen") as TopicStateName);
    for (const p of problems) problemState.set(p.key, (isProblemState(p.state) ? p.state : "unseen") as ProblemStateName);
  } catch (e) {
    loadError = (e as Error).message;
  }
}

const subjects = TRACKER_ORDER.map((slug) => {
  const c = TRACKER[slug];
  const tStates = c.topics.map((t) => topicState.get(t.key) ?? "unseen");
  const pStates = c.problems.map((p) => problemState.get(p.key) ?? "unseen");
  const tc = tally(c.topics.length, tStates, TOPIC_COVERED, TOPIC_MASTERED);
  const pc = tally(c.problems.length, pStates, PROBLEM_COVERED, PROBLEM_MASTERED);

  // "Next action": the first Tier A item not yet covered. This is the whole
  // point of the tracker — it answers "what do I do in the next hour".
  const next =
    c.topics.find((t, i) => t.tier === "A" && !TOPIC_COVERED.has(tStates[i])) ??
    c.topics.find((t, i) => !TOPIC_COVERED.has(tStates[i]));

  const flakyCount =
    tStates.filter((s) => s === "flaky").length;

  const overall =
    pct(tc.covered + pc.covered, tc.total + pc.total);

  return {
    cfg: c,
    topics: tc,
    problems: pc,
    topicPct: pct(tc.covered, tc.total),
    problemPct: pct(pc.covered, pc.total),
    overall,
    next,
    nextAction: next ? studyAction(next.kind, topicState.get(next.key) ?? "unseen") : null,
    flaky: flakyCount,
  };
});

const totals = subjects.reduce(
  (acc, s) => {
    acc.topicTotal += s.topics.total;
    acc.topicCovered += s.topics.covered;
    acc.topicMastered += s.topics.mastered;
    acc.problemTotal += s.problems.total;
    acc.problemCovered += s.problems.covered;
    acc.problemMastered += s.problems.mastered;
    return acc;
  },
  { topicTotal: 0, topicCovered: 0, topicMastered: 0, problemTotal: 0, problemCovered: 0, problemMastered: 0 },
);
const grandPct = pct(totals.topicCovered + totals.problemCovered, totals.topicTotal + totals.problemTotal);
---

<BaseLayout title="Dashboard · MechVault">
  <section class="page">
    <header class="page-head">
      <div>
        <h1>Exam tracker</h1>
        <p class="sub">
          Signed in as <strong>{user?.username ?? user?.name ?? "—"}</strong>.
          Coverage is computed from what you have actually reproduced and solved,
          never from pages you have read.
        </p>
      </div>
    </header>

    {loadError && (
      <div class="alert alert-error" role="alert">
        <strong>Could not load your tracker state.</strong>
        <span>{loadError}</span>
        <span class="hint">Coverage figures below are unavailable, not zero — fix the connection before trusting them.</span>
      </div>
    )}

    <div class="stat-row">
      <div class="stat">
        <span class="stat-num" class:list={{ urgent: days <= 14 }}>{days}</span>
        <span class="stat-label">days to 17 Nov</span>
      </div>
      <div class="stat">
        <span class="stat-num">{windowDays - days}</span>
        <span class="stat-label">day exam window</span>
      </div>
      <div class="stat">
        <span class="stat-num">{grandPct}%</span>
        <span class="stat-label">covered overall</span>
      </div>
      <div class="stat">
        <span class="stat-num">{totals.topicMastered}/{totals.topicTotal}</span>
        <span class="stat-label">topics exam-ready</span>
      </div>
      <div class="stat">
        <span class="stat-num">{totals.problemMastered}/{totals.problemTotal}</span>
        <span class="stat-label">problems exam-speed</span>
      </div>
    </div>

    {!EXAM_ORDER_KNOWN && (
      <p class="note">
        <strong>Subject-wise exam order is not published yet.</strong>
        Timed full-paper simulations cannot be sequenced against the real order,
        so until the timetable lands, rotate papers in the order the Vikunja
        schedule gives you rather than assuming a sequence.
      </p>
    )}

    <h2>What to do next</h2>
    <ul class="next-list">
      {subjects
        .filter((s) => s.next)
        .map((s) => (
          <li class="next-item">
            <a href={`/${s.cfg.slug}/track`} class="next-link">
              <span class="next-subject">{s.cfg.short}</span>
              <span class="next-verb">{s.nextAction?.verb}</span>
              <span class="next-title">{s.next!.title}</span>
            </a>
            <span class="next-detail">{s.nextAction?.detail}</span>
            {s.next?.cue && <span class="next-cue">Cue: {s.next.cue}</span>}
          </li>
        ))}
    </ul>

    <h2>Coverage by subject</h2>
    <div class="grid">
      {subjects.map((s) => (
        <article class="card">
          {/*
            The whole card is one link, not just the title. A card whose only
            live element is its heading is what made these read as decorative
            panels with no next step — the affordance was there but it was only
            16px of underlined text in the corner. The action is also spelled
            out in words, because "it is clickable" is not the same as "this is
            what happens when I click it".
          */}
          <a href={`/${s.cfg.slug}/track`} class="card-hit" aria-label={`Open the ${s.cfg.name} tracker`}></a>

          <header class="card-head">
            <span class="card-mark" aria-hidden="true">{subjectMark(s.cfg.short)}</span>
            <span class="card-titles">
              <span class="card-title">{s.cfg.name}</span>
              <span class="code">{s.cfg.exam.code}</span>
            </span>
            <span class="card-go">Open tracker</span>
          </header>

          <p class="mode">
            <span class="mode-verb">{s.cfg.modeLabel}</span>
            <span class="mode-time">{s.cfg.exam.minutes} min paper</span>
          </p>

          <p class="diag">{s.cfg.diagnosis}</p>

          <div class="bars">
            <div class="bar-row">
              <span class="bar-label">Topics self-tested / exam-ready</span>
              <span class="bar-num">{s.topics.covered}/{s.topics.total}</span>
              <progress class="progress-bar" value={s.topics.covered} max={s.topics.total || 1}></progress>
            </div>
            <div class="bar-row">
              <span class="bar-label">Problems cold-solved / exam-speed</span>
              <span class="bar-num">{s.problems.covered}/{s.problems.total}</span>
              <progress class="progress-bar" value={s.problems.covered} max={s.problems.total || 1}></progress>
            </div>
          </div>

          <div class="card-foot">
            <span class="pill">{s.overall}% overall</span>
            {s.topics.mastered > 0 && <span class="pill good">{s.topics.mastered} exam-ready</span>}
            {s.flaky > 0 && <span class="pill warn">{s.flaky} flaky</span>}
            {s.cfg.decks.length > 0 && <span class="pill">{s.cfg.decks.length} contrast decks</span>}
          </div>
        </article>
      ))}
    </div>

    <h2>How to read this</h2>
    <div class="rules">
      <div class="rule">
        <h3>Covered ≠ read</h3>
        <p>
          A topic only counts once you have marked it <code>self-tested</code>, and the
          tracker refuses that unless you first marked it <code>rederived</code>. The gate
          exists because reading a derivation feels identical to knowing it and is not.
        </p>
      </div>
      <div class="rule">
        <h3>Hints break the chain</h3>
        <p>
          <code>exam-speed</code> requires zero AI hints. A solve that needed three hints is
          evidence of understanding, not of exam readiness, so it will not count.
        </p>
      </div>
      <div class="rule">
        <h3>The subject sets the verb</h3>
        <p>
          Fluid and SOM need <em>derive</em>, Thermo needs <em>chain</em>, Materials and
          Manufacturing need <em>contrast</em>, Numerical needs <em>execute</em>. One generic
          "study" action cannot serve all six.
        </p>
      </div>
      <div class="rule">
        <h3>Evidence is labelled</h3>
        <p>
          Every item says why it is in its tier, and which papers support it. Where an item
          rests on judgement rather than a paper, it says so — a tracker that looks more
          certain than the evidence is worse than no tracker.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==================================================================
     DASHBOARD — the same sheet-metal language as the tracker: square
     corners, hairline rules, ink before colour, spot red only where
     something is actually urgent.

     The old version was a different product entirely: 10px-radius cards,
     a soft grey fill on every stat, pill badges, and three off-token hex
     colours (#d1453b, #1a7f5a, #b8860b) that appeared nowhere else in the
     app. Same content, one visual language.
     ================================================================== */

  .page {
    width: 100%;
    max-width: 84rem;
    margin-inline: auto;
    padding: var(--space-xl) var(--space-xl) var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .page-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-lg) var(--space-xl);
    flex-wrap: wrap;
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }
  .page-head .sub {
    max-width: 68ch;
    line-height: 1.65;
    color: var(--muted);
  }

  /* ---- errors and notes: a full hairline plus a tint, no left bar ---- */
  .alert {
    padding: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: 0;
    display: grid;
    gap: var(--space-xs);
    background: color-mix(in srgb, var(--annotation) 6%, transparent);
  }
  .alert-error { background: color-mix(in srgb, var(--annotation) 10%, transparent); }
  .alert .hint { font-size: var(--font-size-sm); color: var(--muted); }
  .note {
    padding: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: 0;
    max-width: 74ch;
    font-size: var(--font-size-sm);
    line-height: 1.65;
    background: color-mix(in srgb, var(--annotation) 5%, transparent);
  }

  /* ---- the countdown is the one number that matters, so it leads ---- */
  .stat-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 0;
    overflow: hidden;
  }
  .stat {
    padding: var(--space-lg);
    background: var(--surface-1);
    display: grid;
    gap: 2px;
  }
  .stat-num {
    font-family: var(--mono);
    font-size: var(--font-size-hero);
    font-weight: 600;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  /* Under two weeks the countdown turns to the annotation colour. Nothing
     else on this page is allowed to use it. */
  .stat-num.urgent { color: var(--annotation); }
  .stat-label {
    font-size: var(--font-size-sm);
    color: var(--muted);
    line-height: 1.4;
  }

  h2 {
    font-size: var(--font-size-base);
    font-weight: 600;
    margin: 0;
  }

  /* ---- what to do next: a ledger, not a card pile ---- */
  .next-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
    max-width: 74ch;
  }
  .next-item {
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--border);
    display: grid;
    gap: var(--space-sm);
  }
  .next-link {
    display: flex;
    gap: var(--space-md);
    align-items: baseline;
    text-decoration: none;
    color: inherit;
    flex-wrap: wrap;
  }
  .next-subject {
    font-family: var(--mono);
    font-size: var(--font-size-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent);
    min-width: 3rem;
  }
  /* The verb is the whole point of the row: it says what kind of work this
     is (derive / contrast / execute), so it is inked and everything beside
     it is not. */
  .next-verb {
    font-family: var(--mono);
    font-size: var(--font-size-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--annotation);
  }
  .next-title {
    font-size: var(--font-size-base);
    font-weight: 600;
    line-height: 1.4;
  }
  .next-detail, .next-cue {
    font-size: var(--font-size-sm);
    color: var(--muted);
    line-height: 1.6;
    max-width: 68ch;
  }
  .next-cue { font-style: italic; }

  /* ---- subject cards: a two-column band, not a grid of tiles ---- */
  .grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 0;
  }
  .card {
    padding: var(--space-lg);
    background: var(--surface-1);
    display: grid;
    gap: var(--space-md);
    align-content: start;
    /* The card IS the link, so it needs somewhere to put focus and hover. */
    position: relative;
    transition: background 0.15s ease;
  }
  /* One hit area covering the card. Sits under the text so every part is
     clickable without nesting interactive elements. */
  .card-hit {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .card:hover { background: color-mix(in srgb, var(--accent) 4%, var(--surface-1)); }
  .card:has(.card-hit:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .card > *:not(.card-hit) { position: relative; z-index: 1; }

  .card-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }
  /* The mark is set in the app's mono face so it lands on the same grid as
     the numbers below it, and held at low contrast so it reads as a stamp in
     the corner rather than a headline competing with the subject name. */
  .card-mark {
    flex: 0 0 auto;
    margin: 0;
    font-family: var(--mono);
    font-size: 0.5rem;
    line-height: 1.05;
    color: var(--faint);
    white-space: pre;
    user-select: none;
    align-self: flex-start;
  }
  .card-titles {
    flex: 1 1 auto;
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .card-title {
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }
  .card:hover .card-title { color: var(--accent); }
  .code {
    font-family: var(--mono);
    font-size: var(--font-size-label);
    color: var(--muted);
  }
  /* Spelled out, because a link that only looks clickable is the thing this
     change is fixing. Goes to ink on hover, matching the title. */
  .card-go {
    flex: 0 0 auto;
    align-self: center;
    font-family: var(--mono);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    color: var(--accent);
    white-space: nowrap;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    padding-bottom: 1px;
  }
  .card:hover .card-go { border-bottom-color: var(--accent); }
  .mode {
    display: flex;
    gap: var(--space-md);
    align-items: baseline;
    margin: 0;
    flex-wrap: wrap;
  }
  .mode-verb {
    font-family: var(--mono);
    font-size: var(--font-size-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .mode-time { font-size: var(--font-size-sm); color: var(--muted); }
  .diag {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--muted);
    line-height: 1.6;
    max-width: 46ch;
  }

  /* Progress reads as a filled rule under its own label. Flat, no radius,
     because a rounded bar on a square sheet is a leftover from elsewhere. */
  .bars { display: grid; gap: var(--space-md); }
  .bar-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-xs) var(--space-md);
    font-size: var(--font-size-sm);
  }
  .bar-label { color: var(--muted); line-height: 1.4; }
  .bar-num {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .bar-row .progress-bar {
    grid-column: 1 / -1;
    width: 100%;
    height: 4px;
    border-radius: 0;
  }

  /* Foot badges are words with a leading rule, not pills. */
  .card-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--border);
  }
  .pill {
    font-family: var(--mono);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
    color: var(--muted);
    border-left: 1px solid var(--border-strong);
    padding-left: var(--space-sm);
  }
  .pill.good { color: var(--accent); border-left-color: var(--accent); }
  .pill.warn { color: var(--warn); border-left-color: var(--warn); }

  /* ---- the rules are the product's own logic, so they fold ---- */
  .rules {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    background: var(--border);
    border: 1px solid var(--border);
  }
  .rule {
    padding: var(--space-lg);
    background: var(--surface-1);
  }
  .rule h3 {
    font-size: var(--font-size-sm);
    font-weight: 600;
    margin: 0 0 var(--space-xs);
  }
  .rule p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--muted);
    line-height: 1.6;
    max-width: 44ch;
  }
  .rule code { font-size: var(--font-size-running); }

  /* ---- phone: the countdown keeps two columns, the rest stacks ---- */
  @media (max-width: 860px) {
    .page {
      padding: var(--space-lg) var(--space-md) var(--space-xl);
      gap: var(--space-lg);
    }
  }
  @media (max-width: 560px) {
    .stat-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid, .rules { grid-template-columns: minmax(0, 1fr); }
    /* The action drops under the title so the mark never squeezes it. */
    .card-head { flex-wrap: wrap; }
    .card-titles { flex: 1 1 12rem; }
    .card-go { flex: 1 1 100%; border-bottom: none; padding-bottom: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .progress-bar, .card { transition: none; }
  }
</style>

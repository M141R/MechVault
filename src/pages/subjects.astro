---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSubjects } from '../lib/subjects';
const subjects = getSubjects();
---
<BaseLayout title="Subjects | MechVault" active="subjects">
  <header class="page-head">
    <div class="container">
      <nav class="crumbs" aria-label="You are here">
        <a href="/">MechVault</a> · <span>Subjects</span>
      </nav>
      <h1>Subject sheets</h1>
      <p class="lede">Three subjects. One semester. Pick a sheet to open its syllabus, module notes, cheat sheet, and PYQ bank.</p>
    </div>
  </header>

  <main>
    <!-- Subject comparison matrix - the core of this page (desktop) -->
    <section class="section" aria-labelledby="comparison-heading">
      <div class="container">
        <div class="comparison-head">
          <h2 id="comparison-heading">Side-by-side</h2>
          <p>Compare exam codes, paper counts, syllabus scope, and completion status at a glance.</p>
        </div>

        <div class="comparison-table-wrap" tabindex="0" role="region" aria-label="Subject comparison table (horizontal scroll on narrow screens)">
          <table class="comparison-table">
            <thead>
              <tr>
                <th scope="col">Subject</th>
                <th scope="col">Exam code</th>
                <th scope="col">Papers</th>
                <th scope="col">Modules</th>
                <th scope="col">Topics</th>
                <th scope="col">Notes</th>
                <th scope="col">PYQs</th>
                <th scope="col">Cheat sheet</th>
                <th scope="col">Open</th>
              </tr>
            </thead>
            <tbody>
              {subjects.map((subj) => (
                <tr>
                  <td>
                    <div class="subj-cell">
                      <span class="subj-code">{subj.short}</span>
                      <span class="subj-name">{subj.name}</span>
                    </div>
                  </td>
                  <td><code>{subj.code}</code></td>
                  <td><span class="num-badge">{subj.paperCount}</span></td>
                  <td><span class="num-badge">{subj.syllabus.length}</span></td>
                  <td><span class="num-badge">{subj.content.modules.reduce((sum, m) => sum + m.topics.length, 0)}</span></td>
                  <td>
                    <progress class="progress-bar" value={subj.progress} max="100" aria-label={`Notes ${subj.progress}% complete`}>
                      {subj.progress}%
                    </progress>
                  </td>
                  <td>
                    <span class="status-badge" data-status={subj.progress === 100 ? 'ready' : 'partial'}>
                      <svg class="status-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5">
                        {subj.progress === 100 ? '<path d="M4 8l3 3 5-5"/>' : '<circle cx="8" cy="8" r="6" stroke-dasharray="28.27 18.85" stroke-dashoffset="0"/>'}
                      </svg>
                      <span class="status-text">{subj.progress === 100 ? 'Complete' : 'Partial'}</span>
                    </span>
                  </td>
                  <td>
                    <span class="status-badge" data-status={subj.progress === 100 ? 'ready' : 'partial'}>
                      <svg class="status-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5">
                        {subj.progress === 100 ? '<path d="M4 8l3 3 5-5"/>' : '<circle cx="8" cy="8" r="6" stroke-dasharray="28.27 18.85" stroke-dashoffset="0"/>'}
                      </svg>
                      <span class="status-text">{subj.progress === 100 ? 'Ready' : 'In progress'}</span>
                    </span>
                  </td>
                  <td>
                    <a class="btn btn-ghost" href={`/${subj.slug}`} aria-label={`Open ${subj.name} sheet`}>Open →</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Compact subject cards - secondary view for quick scanning, primary on mobile -->
    <section class="section section-alt" aria-labelledby="quick-pick-heading">
      <div class="container">
        <div class="comparison-head">
          <h2 id="quick-pick-heading">Quick pick</h2>
          <p>Each sheet is self-contained: syllabus → modules → cheat → PYQs. Start anywhere.</p>
        </div>

        <div class="subject-sheets">
          {subjects.map((subj) => (
            <article class="subject-sheet" data-subject={subj.slug}>
              <header class="sheet-header">
                <span class="sheet-designator">SHEET {subj.short}-01</span>
                <h3>{subj.name}</h3>
                <span class="sheet-code">{subj.code}</span>
              </header>

              <dl class="sheet-specs">
                <div class="spec-row">
                  <dt>Exam code</dt>
                  <dd><code>{subj.code}</code></dd>
                </div>
                <div class="spec-row">
                  <dt>Papers analyzed</dt>
                  <dd>{subj.paperCount} (MO 2022–2025)</dd>
                </div>
                <div class="spec-row">
                  <dt>Syllabus modules</dt>
                  <dd>{subj.syllabus.length}</dd>
                </div>
                <div class="spec-row">
                  <dt>Indexed topics</dt>
                  <dd>{subj.content.modules.reduce((sum, m) => sum + m.topics.length, 0)}</dd>
                </div>
                <div class="spec-row">
                  <dt>Notes progress</dt>
                  <dd>
                    <progress class="progress-bar inline" value={subj.progress} max="100" aria-label={`Notes ${subj.progress}% complete`}>
                      {subj.progress}%
                    </progress>
                  </dd>
                </div>
                {subj.bookFile && (
                  <div class="spec-row">
                    <dt>Textbook</dt>
                    <dd><a class="book-link" href={`/${subj.slug}/book`}>Read in browser →</a></dd>
                  </div>
                )}
              </dl>

              <p class="sheet-blurb">{subj.description}</p>

              <ul class="sheet-contents">
                <li><span class="bullet" aria-hidden="true">●</span> Official syllabus (PDF-transcribed)</li>
                <li><span class="bullet" aria-hidden="true">●</span> Module notes with derivations & worked examples</li>
                <li><span class="bullet" aria-hidden="true">●</span> Topic-tagged PYQ bank (Mid / End toggle)</li>
                <li><span class="bullet" aria-hidden="true">●</span> Printable cheat sheet</li>
              </ul>

              <a class="sheet-cta" href={`/${subj.slug}`} aria-label={`Open ${subj.name} sheet`}>
                Open sheet →
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- What's inside each sheet - contextual help -->
    <section class="section" aria-labelledby="anatomy-heading">
      <div class="container">
        <div class="comparison-head">
          <h2 id="anatomy-heading">Sheet anatomy</h2>
          <p>Every subject sheet follows the same structure. Know what you're opening.</p>
        </div>

        <div class="anatomy-grid">
          <article class="anatomy-card">
            <div class="anatomy-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <h4>Syllabus</h4>
            <p>Official BIT Mesra syllabus transcribed from the PDF. Modules, topics, and topic-by-topic PYQ mapping.</p>
          </article>
          <article class="anatomy-card">
            <div class="anatomy-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v12"/><path d="M18 9H6"/><path d="M18 15H6"/><path d="M6 3h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/></svg>
            </div>
            <h4>Module notes</h4>
            <p>Derivation-first notes per module. Formulas, worked numericals, exam warnings, and book questions.</p>
          </article>
          <article class="anatomy-card">
            <div class="anatomy-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
            </div>
            <h4>Cheat sheet</h4>
            <p>One-page formula summary. The traps, the shortcuts, the exact equations that decide marks.</p>
          </article>
          <article class="anatomy-card">
            <div class="anatomy-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
            </div>
            <h4>PYQ bank</h4>
            <p>Every question from MO 2022–2025. Tagged by module, year, and exam type (Mid/End). Collapsible answers.</p>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  /* Page header - minimal, no hero-eyebrow */
  .page-head {
    padding: 48px 0 32px;
    border-bottom: 1px solid var(--hairline);
  }
  .page-head .crumbs {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
    margin-bottom: 16px;
  }
  .page-head .crumbs a { color: var(--ink-3); }
  .page-head .crumbs a:hover { color: var(--annotation); }
  .page-head h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin-bottom: 10px;
    letter-spacing: -0.02em;
  }
  .page-head .lede {
    color: var(--ink-2);
    font-size: 16px;
    max-width: 65ch;
    margin: 0;
  }

  /* Comparison table */
  .comparison-head {
    max-width: 680px;
    margin: 0 auto 32px;
    text-align: left;
  }
  .comparison-head h2 {
    font-size: clamp(22px, 3vw, 28px);
    margin-bottom: 8px;
    text-align: left;
  }
  .comparison-head p {
    color: var(--ink-2);
    font-size: 15px;
    margin: 0;
    text-align: left;
  }

  .comparison-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    /* Ensure focus visible for keyboard scroll */
  }
  .comparison-table-wrap:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: var(--radius);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }
  .comparison-table th,
  .comparison-table td {
    padding: 12px 14px;
    text-align: left;
    border-bottom: 1px solid var(--hairline);
    vertical-align: middle;
  }
  .comparison-table th {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    background: var(--surface-2);
    border-bottom: 1px solid var(--border-strong);
    font-weight: 600;
    white-space: nowrap;
  }
  .comparison-table tbody tr:last-child td { border-bottom: none; }
  .comparison-table tbody tr:hover { background: var(--blueprint-soft); }

  .subj-cell { display: flex; flex-direction: column; gap: 2px; min-width: 160px; }
  .subj-code {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--annotation-ink);
    background: var(--annotation-soft);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    width: fit-content;
    border: 1px solid color-mix(in srgb, var(--annotation) 22%, transparent);
  }
  .subj-name { font-family: var(--font); font-weight: 600; font-size: 14.5px; color: var(--ink); }

  .num-badge {
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--blueprint);
    background: var(--blueprint-soft);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }

  /* Accessible progress bar - native <progress> element */
  .progress-bar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: 120px;
    height: 8px;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--blueprint);
    appearance: none;
    border: none;
    background: var(--surface-2);
    border-radius: 4px;
    overflow: hidden;
  }
  .progress-bar.inline { width: 100%; gap: 6px; }
  .progress-bar::-webkit-progress-bar { background: var(--surface-2); border-radius: 4px; }
  .progress-bar::-webkit-progress-value {
    background: var(--annotation);
    border-radius: 4px;
    transition: width 0.3s ease;
  }
  .progress-bar::-moz-progress-bar { background: var(--annotation); border-radius: 4px; }
  /* Fallback for unsupported browsers */
  .progress-bar:not([value]) { background: var(--surface-2); }

  /* Accessible status badge - icon + text, not color-only */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 4px 8px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .status-badge[data-status="ready"] {
    background: var(--annotation-soft);
    color: var(--annotation-ink);
    border: 1px solid color-mix(in srgb, var(--annotation) 35%, transparent);
  }
  .status-badge[data-status="partial"] {
    background: var(--warn-soft);
    color: var(--warn);
    border: 1px solid color-mix(in srgb, var(--warn) 35%, transparent);
  }
  .status-icon {
    display: inline-block;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    stroke: currentColor;
  }
  .status-icon circle {
    stroke: currentColor;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    font-family: var(--font);
    font-size: 12.5px;
    font-weight: 500;
    border: 1px solid var(--hairline);
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .btn-ghost:hover {
    border-color: var(--blueprint);
    color: var(--blueprint);
    background: var(--blueprint-soft);
  }

  /* Subject sheets - compact cards */
  .subject-sheets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 18px;
  }
  .subject-sheet {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 22px;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    display: flex;
    flex-direction: column;
  }
  .subject-sheet:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .sheet-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--hairline);
  }
  .sheet-designator {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .sheet-header h3 {
    font-size: 18px;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .sheet-code {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--blueprint);
    font-weight: 600;
  }

  .sheet-specs {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 16px;
    margin: 0 0 14px;
    padding: 0;
    font-size: 13px;
    color: var(--ink-2);
  }
  .spec-row {
    display: contents;
  }
  .spec-row dt {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: 500;
  }
  .spec-row dd {
    margin: 0;
    font-weight: 500;
    color: var(--ink);
  }
  .spec-row dd code { font-size: 12px; }

  .book-link {
    font-weight: 600;
    color: var(--blueprint);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--blueprint) 35%, transparent);
  }
  .book-link:hover {
    color: var(--annotation);
    border-bottom-color: var(--annotation);
  }

  .sheet-blurb {
    font-size: 13.5px;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0 0 14px;
    flex: 1;
  }

  .sheet-contents {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
    font-size: 12.5px;
    color: var(--ink-2);
  }
  .sheet-contents li { display: flex; align-items: baseline; gap: 8px; }
  .bullet {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--annotation);
    line-height: 1;
  }

  .sheet-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    font-family: var(--font);
    font-size: 13px;
    font-weight: 600;
    border: 1px solid var(--annotation);
    background: var(--annotation);
    color: #fff;
    transition: all 0.15s ease;
    margin-top: auto;
  }
  .sheet-cta:hover {
    background: var(--annotation-ink);
    border-color: var(--annotation-ink);
    transform: translateX(2px);
  }

  /* Anatomy grid */
  .anatomy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 8px;
  }
  .anatomy-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 24px;
    text-align: center;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .anatomy-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }
  .anatomy-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    background: var(--blueprint-soft);
    color: var(--blueprint);
    margin-bottom: 14px;
  }
  .anatomy-icon svg { width: 24px; height: 24px; }
  .anatomy-card h4 {
    font-size: 15px;
    margin-bottom: 8px;
    color: var(--ink);
  }
  .anatomy-card p {
    font-size: 13.5px;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 860px) {
    .comparison-head { text-align: center; }
    .comparison-head h2, .comparison-head p { text-align: center; }
    .sheet-specs { grid-template-columns: auto 1fr; gap: 6px 16px; }
  }
  @media (max-width: 560px) {
    .page-head { padding: 36px 0 24px; }
    .comparison-table th, .comparison-table td { padding: 10px 8px; font-size: 12.5px; }
    .subj-cell { min-width: 120px; }
    /* Hide table on mobile - cards are the primary view */
    .comparison-table-wrap { display: none; }
  }
</style>
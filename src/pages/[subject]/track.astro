---
/**
 * Subject tracker board — the thing you actually work from.
 *
 * Renders the config for one subject and lets state be advanced in place.
 * Server-rendered first so it is usable without JS for reading; the buttons
 * progressively enhance into POSTs.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSubject } from "../../lib/subjects";
import { trackerIsLocal } from "../../lib/auth-single";
import { getTrackerConfig, studyAction } from "../../lib/tracker/config";
import { TOPIC_STATES, PROBLEM_STATES, TOPIC_COVERED, PROBLEM_COVERED, isTopicState, isProblemState } from "../../lib/tracker/engine";
import type { TopicStateName, ProblemStateName } from "../../lib/tracker/engine";
import { questionsForModule, coverageFor } from "../../lib/tracker/pyq-bank";
import { bookQuestionsForModule, bookCoverageFor, bookQuestionLabel, bookPageLabel, bookProblemKey } from "../../lib/tracker/book-bank";

const subject = getSubject(Astro.params.subject);
const cfg = getTrackerConfig(Astro.params.subject);

if (!subject || !cfg) {
  return new Response("Unknown subject", { status: 404 });
}

/**
 * The real exam questions for this subject, from the notes' own PYQ tables.
 *
 * These are the questions the tracker could previously only *count*. Now each
 * module board shows them, with the scanned page they came from, so "19 PYQs"
 * becomes something you can open and attempt rather than a number to trust.
 *
 * A subject with no PYQ table (numerical) renders an explicit empty state
 * naming the gap — never a silent zero, which would read as "you have covered
 * everything and there is nothing to do".
 */
const pyqCoverage = coverageFor(cfg.slug);
const bookCoverage = bookCoverageFor(cfg.slug);

/**
 * Book questions share the PROBLEM state machine with ordinary problems, so a
 * tick on a book row and a tick on a config problem row are the same thing to
 * the store. The key is namespaced by `bq.` so the two never collide.
 */
const topicState = new Map<string, TopicStateName>();
const problemState = new Map<string, ProblemStateName>();
const topicMeta = new Map<string, { errorReason: string | null }>();
const problemMeta = new Map<
  string,
  { hintLevel: number; errorReason: string | null; attempts: number }
>();

// In single-user mode there is no database. Import lib/auth only on the DB path,
// since that import reaches Neon and is exactly what this mode avoids.
const local = trackerIsLocal();
let user: { id: string } | null = null;

if (local) {
  const { singleUserSession } = await import("../../lib/auth-single");
  const s = await singleUserSession(Astro.request);
  // singleUserSession wraps the user in `{ user }`; unwrap it.
  user = s?.user ?? null;
} else {
  const { getSessionSafe } = await import("../../lib/auth");
  const session = await getSessionSafe(Astro.request.headers).catch(() => null);
  user = (session?.user as { id: string } | undefined) ?? null;
}

if (local) {
  // Server has no state to read; the client script hydrates from localStorage.
} else if (user) {
  try {
    const { readStates } = await import("../../lib/tracker/store");
    const { topics, problems } = await readStates(user.id);
    for (const t of topics) {
      topicState.set(t.key, (isTopicState(t.state) ? t.state : "unseen") as TopicStateName);
      if (t.errorReason) topicMeta.set(t.key, { errorReason: t.errorReason });
    }
    for (const p of problems) {
      problemState.set(p.key, (isProblemState(p.state) ? p.state : "unseen") as ProblemStateName);
      problemMeta.set(p.key, {
        hintLevel: p.hintLevel,
        errorReason: p.errorReason,
        attempts: p.attempts,
      });
    }
  } catch {
    // Read-only render; the alert below explains.
  }
}
// ---------------------------------------------------------------------------
// Tallies. Every count shown on this page is recomputed from state at render
// time rather than carried in config, so a row that changes state in the
// browser and reloads still reports the truth.
// ---------------------------------------------------------------------------
const label: Record<string, string> = {
  unseen: "Unseen",
  read: "Read",
  rederived: "Re-derived",
  "self-tested": "Self-tested",
  "exam-ready": "Exam-ready",
  flaky: "Flaky",
  "attempted-fail": "Attempted · failed",
  understood: "Understood",
  "solved-cold": "Solved cold",
  "exam-speed": "Exam speed",
};

function tally(keys: string[], done: (k: string) => boolean) {
  return {
    done: keys.filter(done).length,
    total: keys.length,
  };
}

const modules = [1, 2, 3, 4, 5].map((m) => {
  const topics = cfg.topics.filter((t) => t.module === m);
  const problems = cfg.problems.filter((p) => p.module === m);
  const bookQuestions = bookQuestionsForModule(cfg.slug, m);

  const topicKeys = topics.map((t) => t.key);
  const problemKeys = problems.map((p) => p.key);
  const bookKeys = bookQuestions.map((q) => bookProblemKey(cfg.slug, q));

  const topicTally = tally(topicKeys, (k) =>
    TOPIC_COVERED.has((topicState.get(k) ?? "unseen") as TopicStateName),
  );
  const problemTally = tally(problemKeys, (k) =>
    PROBLEM_COVERED.has((problemState.get(k) ?? "unseen") as ProblemStateName),
  );
  const bookTally = tally(bookKeys, (k) =>
    PROBLEM_COVERED.has((problemState.get(k) ?? "unseen") as ProblemStateName),
  );

  return {
    num: m,
    name: subject.syllabus.find((s) => s.num === m)?.name ?? `Module ${m}`,
    topics,
    problems,
    bookQuestions,
    questions: questionsForModule(cfg.slug, m),
    decks: cfg.decks.filter((d) => d.module === m),
    topicTally,
    problemTally,
    bookTally,
    get trackable() {
      return this.topicTally.total + this.problemTally.total + this.bookTally.total;
    },
    get covered() {
      return this.topicTally.done + this.problemTally.done + this.bookTally.done;
    },
  };
});

/** Only the first module with work starts open; the rest stay folded. */
const firstOpen = modules.findIndex((m) => m.trackable > 0);
---

<BaseLayout title={`${subject.short} tracker · MechVault`}>
  <section
      class="page"
      data-subject={cfg.slug}
      data-storage={local ? "local" : "db"}
      data-label={JSON.stringify(label)}
    >
    <a href="/dashboard" class="back">← Dashboard</a>

    <header class="page-head">
      <div>
        <h1>{cfg.name} <span class="code">{cfg.exam.code}</span></h1>
        <p class="sub">
          <strong>{cfg.modeLabel}</strong> · {cfg.exam.minutes} minutes ·
          {cfg.exam.marksTotal} marks · roughly {cfg.exam.marksPerModule} from each of the
          5 modules
        </p>
      </div>
      <a href={`/${cfg.slug}/book-questions`} class="btn btn-ghost">Book questions</a>
      <a href={`/${cfg.slug}`} class="btn btn-accent">Notes &amp; PYQs</a>
    </header>

    {/*
      One folded disclosure instead of three open prose blocks. On a subject
      like SOM that was ~180 words of framing before the first question, which
      pushed the actual work below the fold. The summary line carries the exam
      caveat, so folding the prose never folds away the fact that the format is
      inferred.
    */}
    <details class="about">
      <summary class="about-head">
        <span class="about-title">How this subject is tracked</span>
        <span class="about-flag">exam format inferred, not official</span>
      </summary>
      <div class="about-body">
        <p><strong>Why this subject works this way.</strong> {cfg.diagnosis}</p>
        <p>
          Exam format is inferred from {cfg.exam.basis} and is <em>not</em> yet
          confirmed against the official notification. Marks:
          {cfg.exam.marksTotal} total, {cfg.exam.marksPerQuestion} per question,
          {cfg.exam.questionsPerModule} question per module.
        </p>
        {local && (
          <p>
            <strong>Single-user mode.</strong> No database is involved — state
            lives in this browser&apos;s localStorage, so clearing site data or
            switching device resets it. An empty tracker is not a reset
            understanding.
          </p>
        )}
      </div>
    </details>

    <div class="filters">
      <label>Tier
        <select id="tier-filter">
          <option value="">All</option>
          <option value="A">Tier A only</option>
          <option value="B">Tier B only</option>
          <option value="C">Tier C only</option>
        </select>
      </label>
      <label>Show
        <select id="state-filter">
          <option value="">Everything</option>
          <option value="unseen">Not started</option>
          <option value="done">Covered (self-tested / exam-ready)</option>
          <option value="flaky">Flaky only</option>
        </select>
      </label>
    </div>

    {modules.map((m, idx) => (
          <section class="module" data-module={m.num} data-open={idx === firstOpen}>
            <details class="module-card" open={idx === firstOpen}>
              <summary class="module-head">
                <span class="mod-num">M{m.num}</span>
                <span class="module-name">{m.name}</span>
                <span class="module-tally">
                  {m.covered} of {m.trackable} covered
                </span>
                <span class="mod-caret" aria-hidden="true">›</span>
              </summary>

              <div class="module-body">
                {/* PYQ panel */}
                {m.questions.length > 0 ? (
                  <details class="panel pyq-panel">
                    <summary class="panel-head">
                      <span class="panel-title">Exam questions</span>
                      <span class="panel-count">{m.questions.length} question{m.questions.length === 1 ? "" : "s"}</span>
                    </summary>
                    <p class="panel-note">
                      Verbatim from {pyqCoverage.code || "the paper"} past papers. Attempt
                      these on blank paper before touching the state controls — the state
                      tracks what you can reproduce, not what you have read.
                    </p>
                    <ol class="pyq-list">
                      {m.questions.map((q) => (
                        <li class="pyq-item" data-qid={q.id}>
                          {/*
                            Provenance collapses to one margin tab. Paper,
                            question number and marks were three separate chips
                            per row; a question number without its paper is
                            unfindable, so they read as one citation. MID/END
                            stays a word rather than a box because the two are
                            not competing kinds of thing - they are positions
                            in one paper.
                          */}
                          <span class="pyq-tab">
                            <span class="pyq-tab-pos">{q.type}</span>
                            <span class="pyq-tab-marks">{q.marks}m</span>
                          </span>
                          <div class="pyq-main">
                            <div class="pyq-item-head">
                              <span class="pyq-qno">{q.paper} · Q.{q.qno}</span>
                              {q.moduleTagInferred && (
                                <span
                                  class="pyq-inf"
                                  title="This MID question's module tag was matched by keyword, not by BIT's verified Qn → Module n ordering. Verify it against the scan."
                                >
                                  module tag inferred
                                </span>
                              )}
                              {q.scanPath && (
                                <a
                                  class="pyq-scan"
                                  href={`/api/file?path=${q.scanPath}`}
                                  target="_blank"
                                  rel="noopener"
                                >
                                  Scanned page ↗
                                </a>
                              )}
                            </div>
                            <p class="pyq-text">{q.text}</p>
                          </div>
                        </li>
                      ))}
                    </ol>
                  </details>
                ) : (
                  <div class="panel pyq-panel pyq-panel-empty">
                    <div class="panel-empty">
                      <strong>No per-question PYQs indexed for this module.</strong>
                      <span>
                        {pyqCoverage.empty
                          ? `${cfg.name} has no per-question question table in the notes yet, so there is nothing to attempt here. That is a gap in the vault, not a sign that the module is unimportant.`
                          : "This module has no questions in the indexed papers."}
                      </span>
                    </div>
                  </div>
                )}

                {/* Book-question tape */}
                {m.bookQuestions.length > 0 && (
                  <details class="panel tape" open>
                    <summary class="panel-head">
                      <span class="panel-title">Textbook problems</span>
                      <span class="panel-count">{m.bookQuestions.length} problem{m.bookQuestions.length === 1 ? "" : "s"}</span>
                    </summary>
                    <p class="panel-note">
                      Chapter and printed page straight from the book&apos;s own
                      contents list. Set the state when you finish one — a
                      cold solve needs a recorded failed attempt first, so use
                      <strong>Attempted · failed</strong> and log what went
                      wrong rather than reaching straight for Solved cold.
                    </p>
                    <ol class="bq-rows">
                      {m.bookQuestions.map((q) => {
                        const st = problemState.get(bookProblemKey(cfg.slug, q)) ?? "unseen";
                        const covered = PROBLEM_COVERED.has(st as ProblemStateName);
                        return (
                          <li
                            class="bq-row"
                            data-bqkey={bookProblemKey(cfg.slug, q)}
                            data-bqstate={st}
                            data-bqcovered={covered ? "1" : "0"}
                          >
                            <label class="bq-tick">
                              <input
                                type="checkbox"
                                class="bq-box"
                                checked={covered}
                                aria-label={`Mark ${bookQuestionLabel(q)} complete`}
                              />
                              <span class="bq-stamp" aria-hidden="true">done</span>
                            </label>
                            <span class="bq-label">{bookQuestionLabel(q)}</span>
                            <span class="bq-display">{q.display}</span>
                            <span class="bq-page">{bookPageLabel(q.page)}</span>
                            {q.marks != null && <span class="bq-marks">{q.marks}m</span>}
                            {q.excluded && (
                              <span
                                class="bq-excluded"
                                title="Your professor's handout lists this problem under EXCLUDE, but the notes cite it as practice. Check the handout before spending time here."
                              >
                                on the exclude list
                              </span>
                            )}
                            {/*
                              This panel used to carry the state as read-only
                              text with only a tick to change it, so the gate
                              message ("open the state menu and choose
                              Attempted · failed") named a control that did
                              not exist here. Same menu and same note box as
                              /book-questions, so a problem behaves the same
                              whichever page you work on.
                            */}
                            <select class="bq-state-select" data-bqkey={bookProblemKey(cfg.slug, q)} aria-label={`State for ${bookQuestionLabel(q)}`}>
                              {PROBLEM_STATES.map((s) => (
                                <option value={s} selected={s === st}>{label[s]}</option>
                              ))}
                            </select>
                            <details class="bq-log">
                              <summary class="bq-log-summary">log what went wrong</summary>
                              <input
                                type="text"
                                class="bq-error"
                                data-bqkey={bookProblemKey(cfg.slug, q)}
                                aria-label={`What went wrong on ${bookQuestionLabel(q)}`}
                                placeholder="e.g. sign error in the Bernoulli step"
                                value={problemMeta.get(bookProblemKey(cfg.slug, q))?.errorReason ?? ""}
                              />
                            </details>
                          </li>
                        );
                      })}
                    </ol>
                  </details>
                )}

                {/* Tracked topics */}
                <details class="panel">
                  <summary class="panel-head">
                    <span class="panel-title">Topics to cover</span>
                    <span class="panel-count">{m.topics.length}</span>
                  </summary>
                  <ul class="ledger">
                    {m.topics.map((t) => {
                      const st = topicState.get(t.key) ?? "unseen";
                      const meta = topicMeta.get(t.key);
                      const act = studyAction(t.kind, st);
                      return (
                        <li class="ledger-row" data-key={t.key} data-kind="topic" data-tier={t.tier} data-state={st}>
                          <span class="ledger-tier tier-{t.tier}">{t.tier}</span>
                          <span class="ledger-title">
                            {t.title}
                            {t.cue && <span class="t-cue">{t.cue}</span>}
                          </span>
                          <span class="ledger-kind">{t.kind}</span>
                          <span class="ledger-evidence">{t.evidence}</span>
                          <span class="ledger-action"><strong>{act.verb}</strong> — {act.detail}</span>
                          <details class="ledger-gap">
                            <summary class="ledger-gap-summary">log a gap</summary>
                            <label class="err">
                              <span>Where it broke</span>
                              <input
                                type="text"
                                class="error-input topic-error-input"
                                data-key={t.key}
                                placeholder="e.g. sign error in the Bernoulli step"
                                value={meta?.errorReason ?? ""}
                              />
                            </label>
                          </details>
                          <select class="state-select" data-key={t.key}>
                            {TOPIC_STATES.map((s) => (
                              <option value={s} selected={s === st}>{label[s]}</option>
                            ))}
                          </select>
                        </li>
                      );
                    })}
                  </ul>
                </details>

                {/* Tracked problems */}
                {m.problems.length > 0 && (
                  <details class="panel">
                    <summary class="panel-head">
                      <span class="panel-title">Problems to solve</span>
                      <span class="panel-count">{m.problems.length}</span>
                    </summary>
                    <ul class="ledger">
                    {m.problems.map((p) => {
                      const st = problemState.get(p.key) ?? "unseen";
                      const meta = problemMeta.get(p.key);
                      const act = studyAction(p.kind, st);
                      return (
                        <li class="ledger-row" data-key={p.key} data-kind="problem" data-state={st}>
                          <span class="ledger-title">{p.title}</span>
                          <span class="ledger-kind">{p.kind}</span>
                          <span class="ledger-evidence">{p.evidence}</span>
                          <span class="ledger-action"><strong>{act.verb}</strong> — {act.detail}</span>
                          <details class="ledger-hints">
                            <summary class="ledger-hints-summary">hints</summary>
                            <label class="hint-label">
                              <span>AI hints</span>
                              <input
                                type="number"
                                class="hint-input"
                                data-key={p.key}
                                min="0"
                                max="9"
                                value={meta?.hintLevel ?? 0}
                                title="AI hints consumed. Must be 0 to reach exam-speed."
                              />
                            </label>
                          </details>
                          {/* A problem row previously had no way to record WHERE it
                              went wrong, so "Attempted · failed" was a state with
                              no note attached to it. The gate asks for a failed
                              attempt; this is where the attempt gets written down. */}
                          <details class="ledger-gap">
                            <summary class="ledger-gap-summary">log what went wrong</summary>
                            <label class="err">
                              <span>Where it broke</span>
                              <input
                                type="text"
                                class="error-input"
                                data-key={p.key}
                                placeholder="e.g. sign error in the Bernoulli step"
                                value={meta?.errorReason ?? ""}
                              />
                            </label>
                          </details>
                          <span class="ledger-pyqs">
                            {(p.pyqs ?? []).map((q) => <span class="pyq">{q}</span>)}
                          </span>
                          <select class="state-select" data-key={p.key}>
                            {PROBLEM_STATES.map((s) => (
                              <option value={s} selected={s === st}>{label[s]}</option>
                            ))}
                          </select>
                        </li>
                      );
                    })}
                  </ul>
                  </details>
                )}

                {/* Recall decks */}
                {m.decks.length > 0 && (
                  <details class="panel decks">
                    <summary class="panel-head">
                      <span class="panel-title">Recall decks</span>
                      <span class="panel-count">{m.decks.reduce((n, d) => n + d.pairs.length, 0)} contrasts</span>
                    </summary>
                    <div class="decks-body">
                      {m.decks.map((d) => (
                        <details class="deck">
                          <summary>
                            <span class="deck-title">{d.title}</span>
                            <span class="deck-count">{d.pairs.length} pairs</span>
                          </summary>
                          <p class="deck-points">{d.evidence}</p>
                          <ul class="pairs">
                            {d.pairs.map((pr) => (
                              <li>
                                <span class="pair-ab">{pr.a}</span>
                                <span class="pair-b">{pr.b}</span>
                                <span class="pair-c">{pr.contrast}</span>
                              </li>
                            ))}
                          </ul>
                        </details>
                      ))}
                    </div>
                  </details>
                )}
              </div>
            </details>
          </section>
        ))}
    <div class="toast" id="toast" hidden></div>
  </section>

  <script>
    import { TOPIC_STATES, PROBLEM_STATES } from "../../lib/tracker/engine";
    import type { TopicStateName, ProblemStateName } from "../../lib/tracker/engine";

    const single =
      document.querySelector(".page")?.getAttribute("data-storage") === "local";

    const toast = document.getElementById("toast") as HTMLElement;
    let toastTimer: ReturnType<typeof setTimeout> | undefined;

    // Human-readable state names, serialized by the server onto .page@data-label.
    const label: Record<string, string> = JSON.parse(
      document.querySelector(".page")?.getAttribute("data-label") ?? "{}",
    );

    function say(msg: string, bad = false) {
      toast.textContent = msg;
      toast.hidden = false;
      toast.dataset.bad = bad ? "1" : "0";
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => (toast.hidden = true), 5200);
    }

    async function post(body: Record<string, unknown>) {
      if (single) {
        // Browser-local persistence, same gates, no network hop.
        if (body.kind === "topic") {
          const { updateLocalTopic } = await import(
            "../../lib/tracker/local-store"
          );
          const res = updateLocalTopic({
            key: String(body.key),
            state: String(body.state),
            errorReason: (body.errorReason as string | null) ?? null,
          });
          if (!res.ok) throw new Error(res.error ?? "save failed");
        }
        return;
      }
      const res = await fetch("/api/progress", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json().catch(() => ({ error: "bad response" }));
      if (!res.ok) throw new Error(data.error ?? "save failed");
    }

    async function saveTopicMeta(key: string) {
      const row = document.querySelector<HTMLElement>(`.ledger-row[data-key="${key}"]`);
      if (!row) return;
      const errText = row.querySelector<HTMLInputElement>(".topic-error-input")?.value ?? "";
      if (single) {
        const { updateLocalTopic } = await import("../../lib/tracker/local-store");
        const res = updateLocalTopic({
          key,
          state: row.dataset.state ?? "unseen",
          errorReason: errText,
        });
        if (!res.ok) throw new Error(res.error ?? "save failed");
        return;
      }
      await post({ kind: "topic", key, state: row.dataset.state ?? "unseen", errorReason: errText });
    }

    async function saveProblemMeta(key: string) {
      const row = document.querySelector<HTMLElement>(`.ledger-row[data-key="${key}"]`);
      if (!row) return;
      const hint = Number(row.querySelector<HTMLInputElement>(".hint-input")?.value ?? 0);
      const errText = row.querySelector<HTMLInputElement>(".error-input")?.value ?? "";
      if (single) {
        const { updateLocalProblem } = await import("../../lib/tracker/local-store");
        const res = updateLocalProblem({
          key,
          state: row.dataset.state ?? "unseen",
          hintLevel: hint,
          errorReason: errText,
        });
        if (!res.ok) throw new Error(res.error ?? "save failed");
        return;
      }

      await post({
        kind: "problem",
        key,
        state: row.dataset.state ?? "unseen",
        hintLevel: hint,
        errorReason: errText,
      });
    }

    for (const sel of document.querySelectorAll<HTMLSelectElement>(".state-select")) {
          sel.addEventListener("change", async (e) => {
            const el = e.target as HTMLSelectElement;
            const row = el.closest<HTMLElement>(".ledger-row");
            if (!row) return;
            const kind = row.dataset.kind;
            const key = row.dataset.key!;
            const to = el.value;
            const previous = row.dataset.state ?? "unseen";
            const allowed = kind === "topic" ? TOPIC_STATES : PROBLEM_STATES;
            if (!(allowed as readonly string[]).includes(to)) {
              say(`Unknown state ${to}.`, true);
              el.value = previous;
              return;
            }
            row.dataset.state = to;
            try {
              if (kind === "problem") await saveProblemMeta(key);
              else await saveTopicMeta(key);
              say(`${key} → ${to.replace(/-/g, " ")}`);
            } catch (err) {
              // The server is the authority on the gates. Revert on refusal so the
              // UI never shows a state the rules did not actually allow.
              row.dataset.state = previous;
              el.value = previous;
              say((err as Error).message, true);
            }
          });
        }

        /* Book-question ticks. A tick is a shortcut for `solved-cold`; un-ticking
           returns the row to `unseen`. It goes through the same problem store and
           the same gates as the state selects, so a tick can never record a state
           the rules would refuse. */
        /*
         * Book-question state. `note` rides along with every write so the log
         * and the state can never disagree; omitting it clears the note, which
         * is what a bare tick does.
         */
        const setProblemState = async (key: string, to: string, note?: string) => {
          const errorReason = note === undefined || note === "" ? null : note;
          if (single) {
            const { updateLocalProblem } = await import("../../lib/tracker/local-store");
            const res = updateLocalProblem({ key, state: to, hintLevel: 0, errorReason });
            if (!res.ok) throw new Error(res.error ?? "save failed");
            return;
          }
          const res = await fetch("/api/progress", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ kind: "problem", key, state: to, hintLevel: 0, errorReason }),
          });
          const data = await res.json().catch(() => ({ error: "bad response" }));
          if (!res.ok) throw new Error(data.error ?? "save failed");
        };

        for (const box of document.querySelectorAll<HTMLInputElement>(".bq-box")) {
          const row = box.closest<HTMLElement>(".bq-row");
          if (!row) continue;
          box.addEventListener("change", async () => {
            const key = row.dataset.bqkey!;
            const to = box.checked ? "solved-cold" : "unseen";
            try {
              await setProblemState(key, to);
              row.dataset.bqstate = to;
              row.dataset.bqcovered = box.checked ? "1" : "0";
              const sel = row.querySelector<HTMLSelectElement>(".bq-state-select");
              if (sel) sel.value = to;
              say(box.checked ? `${key} → solved cold` : `${key} → unseen`);
            } catch (err) {
              box.checked = !box.checked;      // the store is the authority
              say((err as Error).message, true);
            }
          });
        }

        /* Textbook-row state menu. This is the control the gate names when it
           refuses a cold solve, so it must offer Attempted · failed too — the
           same menu exists on /book-questions and both write the same row. */
        for (const sel of document.querySelectorAll<HTMLSelectElement>(".bq-state-select")) {
          sel.addEventListener("change", async () => {
            const row = sel.closest<HTMLElement>(".bq-row");
            if (!row) return;
            const key = sel.dataset.bqkey!;
            const to = sel.value;
            const previous = row.dataset.bqstate ?? "unseen";
            if (!(PROBLEM_STATES as readonly string[]).includes(to)) {
              sel.value = previous;
              say(`Unknown state ${to}.`, true);
              return;
            }
            const note = row.querySelector<HTMLInputElement>(".bq-error")?.value ?? "";
            try {
              await setProblemState(key, to, note);
              row.dataset.bqstate = to;
              const covered = to === "solved-cold" || to === "exam-speed";
              row.dataset.bqcovered = covered ? "1" : "0";
              const box = row.querySelector<HTMLInputElement>(".bq-box");
              if (box) box.checked = covered;
              say(`${key} → ${label[to] ?? to}`);
            } catch (err) {
              sel.value = previous;            // revert; the store refused it
              say((err as Error).message, true);
            }
          });
        }

        /* The failure note on a textbook row. Saves with the current state so a
           note written after choosing Attempted · failed survives a reload. */
        for (const inp of document.querySelectorAll<HTMLInputElement>(".bq-error")) {
          inp.addEventListener("change", async () => {
            const row = inp.closest<HTMLElement>(".bq-row");
            if (!row) return;
            try {
              await setProblemState(
                inp.dataset.bqkey!,
                row.dataset.bqstate ?? "unseen",
                inp.value,
              );
              say("Saved what went wrong.");
            } catch (err) {
              say((err as Error).message, true);
            }
          });
        }

                for (const inp of document.querySelectorAll<HTMLInputElement>(".bq-error")) {
                  inp.addEventListener("change", async () => {
                    const row = inp.closest<HTMLElement>(".bq-row");
                    if (!row) return;
                    try {
                      await setProblemState(
                        inp.dataset.bqkey!,
                        row.dataset.bqstate ?? "unseen",
                        inp.value,
                      );
                      say("Saved what went wrong.");
                    } catch (err) {
                      say((err as Error).message, true);
                    }
                  });
                }

    for (const inp of document.querySelectorAll<HTMLInputElement>(
      ".hint-input, .error-input, .topic-error-input",
    )) {
      inp.addEventListener("change", async () => {
        const key = inp.dataset.key!;
        const row = inp.closest<HTMLElement>(".ledger-row");
        const kind = row?.dataset.kind;
        try {
          if (kind === "topic") await saveTopicMeta(key);
          else await saveProblemMeta(key);
          say("Saved.");
        } catch (err) {
          say((err as Error).message, true);
        }
      });
    }

    const tier = document.getElementById("tier-filter") as HTMLSelectElement | null;
    const state = document.getElementById("state-filter") as HTMLSelectElement | null;

    function applyFilters() {
      const t = tier?.value ?? "";
      const s = state?.value ?? "";
      const covered = new Set([
        "self-tested",
        "exam-ready",
        "solved-cold",
        "exam-speed",
      ]);
      // Rows are <li class="ledger-row">, not <tr>. The old selector matched
            // nothing, which made `any` false and hid every module on load.
            for (const row of document.querySelectorAll<HTMLElement>(".ledger-row[data-key]")) {
              const okTier = !t || row.dataset.tier === t;
              const st = row.dataset.state ?? "";
              const okState =
                !s ||
                (s === "done" && covered.has(st)) ||
                (s === "unseen" && st === "unseen") ||
                (s === "flaky" && st === "flaky");
              row.hidden = !(okTier && okState);
            }
            // A module stays visible when it still has PYQs, decks or book rows to
            // read even if every tracked row is filtered out.
            for (const sec of document.querySelectorAll<HTMLElement>(".module")) {
              const any =
                sec.querySelectorAll(".ledger-row[data-key]:not([hidden])").length > 0 ||
                sec.querySelectorAll(".deck").length > 0 ||
                sec.querySelectorAll(".bq-row").length > 0 ||
                sec.querySelectorAll(".pyq-panel").length > 0;
              sec.hidden = !any;
            }
    }
    tier?.addEventListener("change", applyFilters);
    state?.addEventListener("change", applyFilters);
    applyFilters();
  </script>

<style>
/* ==================================================================
     TRACKER — one folded j-card per module, ledger rows with a margin.

